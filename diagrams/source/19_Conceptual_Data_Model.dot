digraph ERD {
graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.9, fontname="DejaVu Sans", label=<<FONT POINT-SIZE="22" COLOR="#1F3864"><B>19 Conceptual Data Model – RFID Store Inventory (Proposed)</B></FONT><BR/><FONT POINT-SIZE="13" COLOR="#C00000"><I>Analyst-proposed conceptual model for a portfolio case study — not Lojas Renner's database schema</I></FONT>>, labelloc=t, pad=0.4];
node [shape=plain, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=10, color="#7F7F7F", arrowhead=none];
